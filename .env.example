# Server-side AI provider credentials. Never expose with NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4.1-mini

# Provider failover order (comma-separated): gemini,groq,openai
AI_PROVIDER_ORDER=gemini,groq,openai

# Optional photorealistic product-concept rendering (metered image generation)
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
