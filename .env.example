# Server-side AI provider credentials. Never expose with NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_ORDER=gemini,groq,openai

# Photorealistic product-concept rendering
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro


# Separate container worker for engineering toolchain execution
ENGINEERING_WORKER_URL=
ENGINEERING_WORKER_TOKEN=
ENGINEERING_JOB_ACCESS_CODE=
